<h1>Home</h1>
<h2 class="productos"> Productos: </h2>
<div class="contenedorProductos">
  {{#each products}}
    <div class="CardProducto">

      <div class="img">

      </div>

      <div class="productoInfo">
        <div class="title">
          <p> {{this.title}} </p>
        </div>
        <div class="precio">
          <p> {{this.precio}}$ </p>
        </div>
        <div class="descripcion">
          <p> {{this.descripcion}} </p>
        </div>

      </div>
    </div>
  {{/each}}
</div>